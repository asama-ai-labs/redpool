# Sharded proxy settings (tracked in git). Install does not modify this file.
# Repo path, REDPOOL_CONFIG (→ redpool.yaml in the clone), PATH, and PYTHONUNBUFFERED are set in
# /etc/systemd/system/*.d/ by ./install.sh. Add REDPOOL_CONFIG= here only to override that path.
#
# After editing:
#   sudo systemctl daemon-reload && sudo systemctl restart redpool-shard.target
# (daemon-reload is required when REDPOOL_SHARD_NUM_WORKERS changes so the generator re-runs.)
# After moving the clone or changing RUN_AS in install.sh, re-run: sudo ./install.sh

REDPOOL_SHARD_NUM_WORKERS=24
# Redpool does not authenticate callers. Keep this on loopback unless collectors run on other
# hosts; then set 0.0.0.0 (or one interface address) AND restrict who can connect: firewall,
# REDPOOL_ALLOWED_TARGETS, or mitmproxy proxyauth. See SECURITY.md.
REDPOOL_SHARD_FRONT_HOST=127.0.0.1
REDPOOL_SHARD_FRONT_PORT=6000
REDPOOL_SHARD_WORKER_HOST=127.0.0.1
REDPOOL_SHARD_WORKER_PORT_BASE=16101
# Worker systemd instance @i serves /metrics on (BASE + i), e.g. BASE=6101 → 6101, 6102, …
REDPOOL_SHARD_METRICS_PORT_BASE=6101
# Prometheus HTTP SD (/prometheus-sd) on the shard front — independent of worker /metrics ports.
REDPOOL_SHARD_PARENT_ADMIN_PORT=6100
