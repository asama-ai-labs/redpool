#!/usr/bin/env bash
# systemd generator: wire redpool-shard.target → N worker instances + front.
# Reads REDPOOL_SHARD_NUM_WORKERS from deploy/systemd/redpool-shard.env in this repo.
# install.sh copies this script to /etc/systemd/system-generators/ (root-owned, so root never
# runs a file from the clone) and sets CONF_OVERRIDE to the absolute path of that env file.
# Only a validated number is read from it. Run from the repo, it uses the file next to it.
set -euo pipefail

CONF_OVERRIDE=""

NORMAL_DIR="${1:?}"

if [[ -n "${CONF_OVERRIDE}" ]]; then
  CONF="${CONF_OVERRIDE}"
else
  _script="${BASH_SOURCE[0]:-$0}"
  _real=$(readlink -f "$_script" 2>/dev/null || true)
  if [[ -z "${_real}" ]]; then
    _real=$_script
  fi
  GEN_DIR=$(cd "$(dirname "$_real")" && pwd)
  CONF="${GEN_DIR}/../redpool-shard.env"
fi
NUM=4
if [[ -r "$CONF" ]]; then
  line="$(grep -E '^[[:space:]]*REDPOOL_SHARD_NUM_WORKERS=' "$CONF" | tail -n1 || true)"
  if [[ -n "${line}" ]]; then
    NUM="${line#*=}"
    NUM="${NUM//[[:space:]]/}"
  fi
else
  echo "redpool-shard-generator: missing ${CONF} (keep deploy/systemd/redpool-shard.env in the repo), using NUM=4" >&2
fi
if ! [[ "${NUM}" =~ ^[1-9][0-9]*$ ]]; then
  echo "redpool-shard-generator: invalid REDPOOL_SHARD_NUM_WORKERS='${NUM}', using 4" >&2
  NUM=4
fi

WANTS="${NORMAL_DIR}/redpool-shard.target.wants"
DROP="${NORMAL_DIR}/redpool-shard-front.service.d"
mkdir -p "${WANTS}" "${DROP}"

ETC=/etc/systemd/system
for ((i = 0; i < NUM; i++)); do
  ln -sf "${ETC}/redpool-shard-worker@.service" "${WANTS}/redpool-shard-worker@${i}.service"
done
ln -sf "${ETC}/redpool-shard-front.service" "${WANTS}/redpool-shard-front.service"

{
  echo '# Generated by redpool-shard-generator — do not edit.'
  echo '[Unit]'
  for ((i = 0; i < NUM; i++)); do
    echo "After=redpool-shard-worker@${i}.service"
  done
} >"${DROP}/10-after-workers.conf"
