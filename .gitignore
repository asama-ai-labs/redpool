# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib*
__pycache__/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.venv/
myenv/

# Generated coverage report (regenerate with scripts/fishymetrics_coverage_report.py)
fishymetrics_coverage_report.md

# Per-model mock/proxy/fishymetrics logs and scrape output (scripts/fishymetrics_coverage_report.py --log-dir)
fishymetrics_coverage_logs/

# Proxy config for fishymetrics golden generation
.redpool-golden-config.yaml

.vscode/
build

